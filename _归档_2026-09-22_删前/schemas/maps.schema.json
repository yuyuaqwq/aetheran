{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "maps",
  "type": "object",
  "required": [
    "nodes",
    "edges"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string"
        }
      }
    },
    "stats": {
      "type": "object"
    }
  },
  "defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^NODE_"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "lv_min": {
          "type": "integer"
        },
        "lv_max": {
          "type": "integer"
        }
      }
    }
  }
}
