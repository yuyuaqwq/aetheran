{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "阿斯特兰 · 图鉴四谱（codex 域）—— 材料谱 / 风味谱 / 怪物谱 / 旧物谱",
  "description": "本域由 scripts/rebuild_codex.py 从 00_总纲/14_图鉴四谱口径_v1.md 解析生成；条目 id 与 items / monsters / pois 三域逐条对账。",
  "type": "object",
  "patternProperties": {
    "^_": {
      "type": "object",
      "description": "私有键（_meta 那类）—— 与编辑器/装载器同口径：不是条目"
    },
    "^(material|flavor)$": {
      "type": "object",
      "description": "材料谱 / 风味谱：条目 = 物品 id → 名字 + 一句人话",
      "patternProperties": {
        "^i_[a-z0-9_]+$": {
          "type": "object",
          "required": ["name", "line"],
          "properties": {
            "name": {"type": "string"},
            "line": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "^monster$": {
      "type": "object",
      "description": "怪物谱：条目 = 怪 id → 名字 + 一句习性（★ 不写数值）",
      "patternProperties": {
        "^ms_[a-z0-9_]+$": {
          "type": "object",
          "required": ["name", "line"],
          "properties": {
            "name": {"type": "string"},
            "line": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "^relic$": {
      "type": "object",
      "description": "旧物谱：条目 = 可读物 poi 或旧东西的 item/未鉴定 id → 问号行 + 认出后的行 + 谁认得出",
      "patternProperties": {
        "^(poi|i|unid)_[a-z0-9_]+$": {
          "type": "object",
          "required": ["name", "from", "hint", "known", "ask"],
          "properties": {
            "name": {"type": "string"},
            "from": {"enum": ["read", "pick"]},
            "hint": {"type": "string", "description": "还没认出来时那一行（前面由 UI 加问号）"},
            "known": {"type": "string", "description": "认出来之后那一行"},
            "ask": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "pattern": "^npc_[a-z0-9_]+$"},
              "description": "认得出它的 NPC（搭话时把问号换成名字）"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
