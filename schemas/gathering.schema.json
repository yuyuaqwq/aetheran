{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "阿斯特兰 · 采集点（gathering 域）",
  "type": "object",
  "patternProperties": {
    "^gt_[a-z0-9_]+$": {
      "type": "object",
      "required": [
        "name",
        "map",
        "subarea",
        "kind",
        "pool"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "map": {
          "type": "string"
        },
        "subarea": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "采药",
            "挖掘",
            "垂钓",
            "搜查",
            "巢",
            "矿脉"
          ]
        },
        "pool": {
          "type": "array"
        },
        "time": {
          "type": [
            "string",
            "null"
          ]
        },
        "desc": {
          "type": "string"
        },
        "times_per_day": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
