{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "真源在包（schema 住包）。字段照引擎 ext_world.space 的消费端：name/roles/nodes/topology。",
  "type": "object",
  "minProperties": 1,
  "patternProperties": {
    "^[a-z_]+$": {
      "type": "object",
      "required": [
        "name",
        "roles",
        "nodes",
        "topology"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "roles": {
          "type": "object",
          "description": "角色映射：hub/through/exit → 显示类别名"
        },
        "topology": {
          "enum": [
            "star",
            "chain",
            "free"
          ],
          "description": "star=城镇（中心辐射）· chain=野外（线性相邻）· free=自定义"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "role"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
