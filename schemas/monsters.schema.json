{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "真源在包。字段照 ext_combat 的消费端（面板栈 + 效果总线 + phases）。panel 由 scripts/rebuild_monsters.py 按「档位 × 原型」复算，不手打。",
  "type": "object",
  "minProperties": 1,
  "patternProperties": {
    "^ms_[a-z_]+$": {
      "type": "object",
      "required": [
        "name",
        "archetype",
        "role",
        "role_key",
        "lv",
        "panel",
        "mods"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "archetype": {
          "enum": [
            "杂兵",
            "快速",
            "厚甲",
            "法系",
            "群居",
            "消耗",
            "爆发",
            "支援"
          ]
        },
        "role": {
          "enum": [
            "普通",
            "精英",
            "头目",
            "层主",
            "boss"
          ]
        },
        "role_key": {
          "enum": [
            "normal",
            "elite",
            "chief",
            "warden",
            "boss"
          ],
          "$comment": "★ B3-6b-2d-keys-2：`role` 的 **ASCII 机器键** —— 代码只认它（挑遇敌 / 掉钱分档 / 是不是 BOSS；K48 / K51 / P-20 甲案第二刀）。取值口径：普通=normal · 精英=elite · 头目=chief（区域头目）· 层主=warden（副本层主）· boss（世界 Boss）。★ 头目 / 层主**不是** boss（引擎 `ext_combat` 比的是 `role == \"boss\"`，今天只有世界 Boss 命中）。映射表唯一来源 = `scripts/rebuild_monsters.py`（与本 enum 两头对账，见 probe_monsters ⑧）；中文 `role` 是策划案原文的档位名，保留。"
        },
        "lv": {
          "type": "integer"
        },
        "panel": {
          "type": "object",
          "required": [
            "hp",
            "atk",
            "def",
            "spd",
            "hit",
            "eva",
            "crit"
          ],
          "properties": {
            "hp": {
              "type": "number"
            },
            "atk": {
              "type": "number"
            },
            "def": {
              "type": "number"
            },
            "res": {
              "type": "number"
            },
            "spd": {
              "type": "number"
            },
            "hit": {
              "type": "number"
            },
            "eva": {
              "type": "number"
            },
            "crit": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "drops": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mods": {
          "type": "object",
          "properties": {
            "hp_mult": {
              "type": "number"
            },
            "atk_mult": {
              "type": "number"
            },
            "party_scale": {
              "type": "object",
              "description": "★ B3-17：**按队伍人数缩放面板**的表（键 = 队伍人数，值 = 面板倍数，键名照域里 panel 那一套）—— 真源 `12_…_v1.md` §一④／`17_组队与策略配合_v1.md` §五／`22_旧哨塔_逐间设计_v1.md` §三④「组队时按人数缩放（P1 单人也能过）」。只有**团队内容**（Boss）有这一格；文档没给数的人数**不写**（查不到 ⇒ 走设计值，fail-closed 见 `content/combat.party_scale_of`）。生成器唯一来源 = `scripts/rebuild_monsters.PARTY_SCALE`。",
              "patternProperties": {
                "^[1-9][0-9]*$": {
                  "type": "object",
                  "minProperties": 1,
                  "properties": {
                    "hp": {
                      "type": "number"
                    },
                    "atk": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "mech": {
              "type": "string"
            },
            "phases": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        },
        "elite_pool": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string"
          },
          "description": "该怪可出的精英词条（Boss 为空）"
        },
        "encounter_lines": {
          "type": "array",
          "description": "★ 战内台词（B3-4 装备事件）：打这只怪时它先开口的话 —— [{need, text}]。need 的形状与 dialogues 域同（holding=<物品 id> 等，判定走同一口 cmds_talk._pick_indexed）；第一条满足的胜出。",
          "items": {
            "type": "object",
            "required": [
              "need",
              "text"
            ],
            "properties": {
              "need": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
