{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "真源在包。字段照 ext_world 的节点级挂载 + 条件槽（judges）的消费端。",
  "type": "object",
  "minProperties": 1,
  "patternProperties": {
    "^poi_[a-z_]+$": {
      "type": "object",
      "required": [
        "name",
        "icon",
        "kind",
        "map",
        "subarea"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "可读物",
            "触摸",
            "生息",
            "发现",
            "危险",
            "隐藏点"
          ]
        },
        "map": {
          "type": "string"
        },
        "subarea": {
          "type": "string"
        },
        "hint": {
          "type": "string",
          "description": "观察时看到的一行"
        },
        "read_text": {
          "type": "string",
          "description": "可读物：正文的文案槽位"
        },
        "into_codex": {
          "type": "string",
          "description": "读完后进哪本谱（非空时只认 relic_codex）；**空串 = 读它但不进谱** —— 只许塔内的就地线索这么写（22 §二「可做」列 · 见工作树 _notes.md §一 的裁决）"
        },
        "effect": {
          "type": "object",
          "description": "触摸/生息/隐藏点的效果"
        },
        "condition": {
          "type": "object",
          "description": "出现条件 —— 键词表只有五个，每个键一本账（判定唯一口 = content/cmds_ast._poi_cond；键名单与 POI_COND_KEYS 逐值相等，probe_pois ⑫ 钉着）：time / weather = 时辰或天气（与 npcs 同一套 token）· event = 世界事件 · quest = 那一条委托交没交（如 q_main_06）· read = 读到过那条可读物（如 poi_repeated_mark）。判不出的（键不在表里 / 值查不到账，如「退潮」）**不当成不成立**：照旧在场 + 点名（台账 P-31 甲 · 待真源定刻度）",
          "propertyNames": {
            "enum": [
              "time",
              "weather",
              "event",
              "quest",
              "read"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
