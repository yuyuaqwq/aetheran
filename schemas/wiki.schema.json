{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "《艾瑟兰：织誓》wiki 域（条目索引）schema —— 真源在包。字段级口径真源 = aetheran-designer/11_数据包Wiki/02_字段规范.md（v1.1）；条目 body 的字段表真源 = 01_条目模板/*.md（12 份）。★ 不用 $ref（框架最小校验器不解析 $ref，见包内 skill.schema.json 的同类注释）⇒ 条目定义内联。",
  "title": "wiki",
  "x-primary": "entry",
  "type": "object",
  "patternProperties": {
    "^_": {
      "type": "object",
      "$comment": "私有键/文件级元信息（白名单：_meta/_categories/_reveal_policy/_index_cfg/_lock_reason）—— **不是条目**（引擎唯一口径 editor/packages.py::is_entry_key()），V9 管这里"
    },
    "^WIKI_": {
      "type": "object",
      "required": [
        "id",
        "prefix",
        "type",
        "domain",
        "name",
        "status",
        "phase",
        "reveal",
        "aliases",
        "search_keys",
        "source",
        "ref",
        "summary_key",
        "version"
      ],
      "$comment": "必填在这里是**索引层**的必填（比 02_字段规范 §3.1 的玩家侧 9 项多 prefix/domain/summary_key/id/version，见 x-field-spec）。",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^WIKI_"
        },
        "prefix": {
          "type": "string",
          "enum": [
            "ATTR",
            "FORMULA",
            "CLS",
            "SKILL",
            "ITEM",
            "MON",
            "BOSS",
            "NODE",
            "QUEST",
            "EBUFF",
            "ELE",
            "SYS"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "attr",
            "formula",
            "cls",
            "skill",
            "item",
            "mon",
            "boss",
            "node",
            "quest",
            "ebuff",
            "ele",
            "sys"
          ]
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "status": {
          "type": "string",
          "enum": [
            "草稿",
            "待审",
            "已发布",
            "已废弃",
            "pending_data"
          ],
          "$comment": "前 4 项 = 00_Wiki §5 的四态；pending_data = 本路新增（数据文件/ID 未落地，占位等回填），玩家侧与 草稿 同处理（不可查）"
        },
        "phase": {
          "type": "string",
          "enum": [
            "P1",
            "P2",
            "P3",
            "P4",
            "P5"
          ]
        },
        "reveal": {
          "type": "string",
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 4
        },
        "search_keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8
        },
        "source": {
          "type": "string",
          "pattern": "^content/(data|rules)/.+\\.json#.+$"
        },
        "ref": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^WIKI_"
          },
          "maxItems": 8
        },
        "summary_key": {
          "type": "string",
          "pattern": "^wiki\\.[a-z]+\\.[a-z0-9_]+\\.summary$"
        },
        "version": {
          "type": "string",
          "pattern": "^v\\d+\\.\\d+$"
        },
        "updated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 6
        },
        "body": {
          "type": "object",
          "$comment": "按 type 走 01_条目模板/<类型>.md 的字段表；字段名必须与 schemas/<域>.schema.json 逐字一致（G1）"
        },
        "reveal_over": {
          "type": "object",
          "$comment": "只许收紧（V6）"
        },
        "i18n": {
          "type": "object",
          "$comment": "只允许覆盖 name/aliases/search_keys（§4）"
        },
        "superseded_by": {
          "type": "string",
          "pattern": "^WIKI_"
        },
        "deprecate_reason": {
          "type": "string",
          "maxLength": 40
        },
        "private": {
          "type": "boolean"
        },
        "display_name": {
          "type": "object"
        },
        "template": {
          "type": "string"
        },
        "body_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id_provisional": {
          "type": "boolean"
        },
        "name_provisional": {
          "type": "boolean"
        },
        "_note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "x-state-machine": {
    "草稿": "字段不全/source 未对",
    "待审": "字段齐、可生成、揭示档未抽查",
    "已发布": "玩家可见的唯一状态",
    "已废弃": "只读·不进搜索·直查可达",
    "pending_data": "本路新增：上游数据文件或 #<ID> 未落地（与 草稿 同样不可查）"
  },
  "x-field-spec": {
    "required_9_玩家侧": [
      "type",
      "name",
      "status",
      "phase",
      "reveal",
      "aliases",
      "search_keys",
      "source",
      "ref"
    ],
    "optional_declared_12": 12,
    "optional_actual_10": [
      "version",
      "updated",
      "tags",
      "body",
      "reveal_over",
      "i18n",
      "superseded_by",
      "deprecate_reason",
      "private",
      "display_name"
    ],
    "optional_missing_2_candidates": [
      "render",
      "i18n.default_lang"
    ],
    "field_rules": [
      "G1 body 字段名与 schemas/<域>.schema.json 逐字一致",
      "G2 条目内不许存数值真源",
      "G3 枚举值只准用中文词或纯 ASCII 中性词"
    ]
  },
  "x-validators": {
    "V1": {
      "rule": "^WIKI_[a-z0-9_]+$（域段用类型名）",
      "on_violation": "门禁红",
      "conflict": "★ 与 00_Wiki §3.1 的 12 个条目 ID 形态冲突（模板用大写：F<编号>/<英文名>/<职业缩写>/<S编号>/<主支带>）⇒ 本 schema 的 key pattern 取 ^WIKI_，V1 的窄正则待裁"
    },
    "V2": {
      "rule": "type 与 source 的域一致",
      "on_violation": "门禁红"
    },
    "V3": {
      "rule": "source 的 #<ID> 必须在该 JSON 里存在",
      "on_violation": "门禁红（条目回 草稿）"
    },
    "V4": {
      "rule": "body 数值 == source 对应字段",
      "on_violation": "门禁红"
    },
    "V5": {
      "rule": "ref 目标存在且 status ∈ {待审, 已发布}",
      "on_violation": "门禁红"
    },
    "V6": {
      "rule": "reveal_over 只许收紧",
      "on_violation": "门禁红"
    },
    "V7": {
      "rule": "已发布 必须有 version+updated+body",
      "on_violation": "门禁红"
    },
    "V8": {
      "rule": "上游数值 hash 变化 ⇒ 自动回 待审",
      "on_violation": "自动降级"
    },
    "V9": {
      "rule": "私有键必须在白名单内",
      "on_violation": "门禁红"
    },
    "V10": {
      "rule": "search_keys 禁策划词（PE/门禁/教学轴/K_rate…）",
      "on_violation": "门禁红"
    }
  },
  "x-reveal": {
    "R0": "直给",
    "R1": "区间",
    "R2": "条件",
    "R3": "自试",
    "tighten": "R0→R1/R2/R3；R1→R2/R3；R2→R3；R3 不可改"
  },
  "x-counts": {
    "designed_total": 111,
    "actual_total": 106,
    "by_prefix": {
      "ATTR": {
        "designed": 19,
        "actual": 15
      },
      "FORMULA": {
        "designed": 12,
        "actual": 12
      },
      "CLS": {
        "designed": 7,
        "actual": 7
      },
      "SKILL": {
        "designed": 14,
        "actual": 14
      },
      "ITEM": {
        "designed": 12,
        "actual": 12
      },
      "MON": {
        "designed": 16,
        "actual": 15
      },
      "BOSS": {
        "designed": 1,
        "actual": 1
      },
      "NODE": {
        "designed": 8,
        "actual": 8
      },
      "QUEST": {
        "designed": 4,
        "actual": 4
      },
      "EBUFF": {
        "designed": 4,
        "actual": 4
      },
      "ELE": {
        "designed": 6,
        "actual": 6
      },
      "SYS": {
        "designed": 8,
        "actual": 8
      }
    },
    "diff_reason": "111 是「条目槽位」数，含 5 个重复槽位：ATTR 的 prec/cast_spd/tenacity/block 在 数据字典 §2.2 与 §2.3 各计一次（4）；P1 层主同时进 MON 16 与 BOSS 1（1）⇒ 去重后 106"
  }
}
